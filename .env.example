# DairyFlow Mobile Environment Configuration

# Backend API Base URL
# For Android Emulator, use: http://10.0.2.2:3000
# For iOS Simulator / Web, use: http://localhost:3000
# For Physical Phone on same Wi-Fi, use your PC's LAN IP: e.g. http://192.168.1.50:3000
#
# Production MUST use https:// (Android release builds block plain http:// traffic).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Per-profile values for EAS builds live in eas.json (development/preview/production).
# Copy this file to .env.local for local overrides; never commit real secrets.
